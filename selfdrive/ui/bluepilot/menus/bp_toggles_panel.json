          ],
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        }
      ]
    },
    {
      "groupName": "coreTogglesGroup",
      "title": "核心设置",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "OpenpilotEnabledToggle",
          "title": "启用sunnypilot",
          "desc": "使用sunnypilot系统进行自适应巡航控制和车道保持辅助。使用此功能时，您需要始终保持注意力。",
          "icon": "../assets/icons/chffr_wheel.png",
          "needs_restart": true,
          "dynamic_desc": true,
          "descriptions": {
            "default": "使用sunnypilot系统进行自适应巡航控制和车道保持辅助。使用此功能时，您需要始终保持注意力。",
            "needs_restart": "使用sunnypilot系统进行自适应巡航控制和车道保持辅助。使用此功能时，您需要始终保持注意力。如果车辆已启动，更改此设置将重启openpilot。"
          },
          "description_conditions": {
            "needs_restart": {
              "paramNotLocked": "OpenpilotEnabledToggle"
            }
          },
          "enableConditions": {
            "paramNotLocked": "OpenpilotEnabledToggle",
            "reason": "Setting is locked"
          }
        },
        {
          "type": "toggle",
          "param": "ExperimentalMode",
          "title": "实验模式",
          "desc": "openpilot默认以轻松模式驾驶。实验模式启用尚未准备好用于轻松模式的alpha级功能。",
          "icon": "../assets/icons/experimental_white.svg",
          "active_icon": "../assets/icons/experimental.svg",
          "confirm": true,
          "confirm_text": "openpilot默认以<b>轻松模式</b>驾驶。实验模式启用尚未准备好用于轻松模式的<b>alpha级功能</b>。实验功能如下：<br><br><h4>端到端纵向控制</h4><br>让驾驶模型控制油门和制动。openpilot将按照它认为人类会做的方式驾驶，包括在红灯和停车标志处停车。由于驾驶模型决定行驶速度，设定速度仅作为上限。这是一个alpha质量的功能；可能会出现错误。<br><h4>新驾驶可视化</h4><br>驾驶可视化将在低速时切换到面向道路的广角摄像头，以更好地显示一些转弯。实验模式徽标也将显示在右上角。",
          "confirm_yes_text": "启用",
          "confirm_no_text": "取消",
          "auto_reset_value": "0",
          "enableConditions": {
            "anyConditionsTrue": [
              {
                "hasCarParams": false,
                "reason": "启动车辆以启用此设置"
              },
              {
                "hasLongitudinalControl": true,
                "reason": "需要纵向控制"
              },
              {
                "allConditionsTrue": [
                  {
                    "hasAlphaLongitudinalAvailable": true,
                    "reason": "需要alpha纵向控制可用"
                  },
                  {
                    "isNotReleaseBranch": true,
                    "reason": "仅在开发分支上可用"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "DynamicExperimentalControl",
          "title": "启用动态实验控制",
          "desc": "启用此开关以允许模型决定何时使用sunnypilot ACC或sunnypilot端到端纵向控制。",
          "icon": "../assets/offroad/icon_blank.png"
        }
      ]
    },
    {
      "groupName": "drivingBehaviorGroup",
      "title": "驾驶行为",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "DisengageOnAccelerator",
          "title": "在加速踏板上解除",
          "desc": "启用后，按下加速踏板将解除sunnypilot。",
          "icon": "../assets/icons/disengage_on_accelerator.svg"
        },
        {
          "type": "segmented_control",
          "param": "LongitudinalPersonality",
          "title": "驾驶个性",
          "desc": "推荐使用标准模式。在激进模式下，sunnypilot将更接近前车，并在油门和制动方面更加激进。在轻松模式下，sunnypilot将与前车保持更远的距离。在支持的车辆上，您可以使用方向盘距离按钮在这些个性之间循环切换。",
          "showDescBottom": true,
          "icon": "../assets/icons/speed_limit.png",
          "options": [
            { "name": "激进", "value": "0" },
            { "name": "标准", "value": "1", "default": true },
            { "name": "轻松", "value": "2" }
          ],
          "dynamic_desc": true,
          "descriptions": {
            "default": "推荐使用标准模式。在激进模式下，sunnypilot将更接近前车，并在油门和制动方面更加激进。在轻松模式下，sunnypilot将与前车保持更远的距离。在支持的车辆上，您可以使用方向盘距离按钮在这些个性之间循环切换。",
            "no_car": "请启动车辆以检查兼容性。",
            "no_longitudinal": "此功能需要纵向控制可用。"
          },
          "description_conditions": {
            "no_car": {
              "isOffroad": true,
              "reason": "Start the vehicle to check compatibility"
            },
            "no_longitudinal": {
              "allConditionsTrue": [
                { "isOnroad": true },
                {
                  "hasLongitudinalControl": false,
                  "reason": "Requires longitudinal control"
                }
              ]
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "isOnroad": true,
                "reason": "启动车辆以启用此设置"
              },
              {
                "hasLongitudinalControl": true,
                "reason": "需要纵向控制"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "safetyGroup",
      "title": "安全",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "IsLdwEnabled",
          "title": "启用车道偏离警告",
          "desc": "当您的车辆在没有激活转向灯的情况下超过检测到的车道线，且行驶速度超过31 mph（50 km/h）时，接收提醒以转向回到车道。",
          "icon": "../assets/icons/warning.png"
        },
        {
          "type": "toggle",
          "param": "AlwaysOnDM",
          "title": "始终开启驾驶员监控",
          "desc": "即使sunnypilot未接合时也启用驾驶员监控。",
          "icon": "../assets/icons/monitoring.png"
        }
      ]
    },
    {
      "groupName": "clusterPreferencesGroup",
      "title": "BluePilot仪表盘偏好：",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "FordPrefSendHandsFreeCanMsg",
          "title": "显示免提UI（在支持的车辆上）",
          "desc": "[BLUEPILOT] 为支持的车辆启用免提UI。",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "toggle",
          "param": "FordPrefLaneDepartCanMsg",
          "title": "向车辆发送车道偏离信号",
          "desc": "[BLUEPILOT] 发送Openpilot车道偏离信号以进行原生仪表盘警报。",
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        }
      ]
    },
    {
      "groupName": "recordingGroup",
      "title": "录制",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "RecordFront",
          "title": "录制并上传驾驶员摄像头",
          "desc": "上传来自面向驾驶员的摄像头的数据，帮助改进驾驶员监控算法。",
          "icon": "../assets/icons/monitoring.png",
          "needs_restart": true,
          "dynamic_desc": true,
          "descriptions": {
            "default": "上传来自面向驾驶员的摄像头的数据，帮助改进驾驶员监控算法。",
            "needs_restart": "上传来自面向驾驶员的摄像头的数据，帮助改进驾驶员监控算法。如果车辆已启动，更改此设置将重启openpilot。"
          },
          "description_conditions": {
            "needs_restart": {
              "paramNotLocked": "RecordFront"
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "paramNotLocked": "RecordFront",
                "reason": "Setting is locked"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "RecordAudio",
          "title": "录制并上传麦克风音频",
          "desc": "在驾驶时录制并存储麦克风音频。音频将包含在comma connect中的行车记录仪视频中。",
          "icon": "../assets/icons/microphone.png",
          "needs_restart": true,
          "dynamic_desc": true,
          "descriptions": {
            "default": "在驾驶时录制并存储麦克风音频。音频将包含在comma connect中的行车记录仪视频中。",
            "needs_restart": "在驾驶时录制并存储麦克风音频。音频将包含在comma connect中的行车记录仪视频中。如果车辆已启动，更改此设置将重启openpilot。"
          },
          "description_conditions": {
            "needs_restart": {
              "paramNotLocked": "RecordAudio"
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "paramNotLocked": "RecordAudio",
                "reason": "Setting is locked"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "unitsGroup",
      "title": "单位",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "IsMetric",
          "title": "使用公制系统",
          "desc": "以km/h而不是mph显示速度。",
          "icon": "../assets/icons/metric.png"
        }
      ]
    },
    {
      "groupName": "bluepilotSystemGroup",
      "title": "BluePilot系统",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "DisableGPSAlert",
          "title": "禁用GPS警报",
          "desc": "[BluePilot] 禁用GPS警报。如果您不想因为comma设备的安装方式导致GPS信号弱时收到警报，这很有用。",
          "hidden": false
        }
      ]
    }
  ]
}
