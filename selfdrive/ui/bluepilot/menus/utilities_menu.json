{
  "_comment": "This configuration file defines all utilities panels, groups, and controls.",
  "menuName": "工具",
  "menuIcon": "icon_utilities.png",
  "menuDescription": "工具面板",
  "persistentParams": [],
  "clearOnManagerStartParams": [],
  "clearOnOnroadTransitionParams": [],
  "clearOnOffroadTransitionParams": [],
  "groups": [
    {
      "groupName": "utilityCommandsGroup",
      "title": "实用命令：",
      "enableResetButton": false,
      "controls": [
        {
          "type": "model_data_viewer",
          "title": "模型数据查看器",
          "desc": "查看模型数据",
          "hidden": true
        },
        {
          "type": "param_list_viewer",
          "title": "所有参数",
          "desc": "查看系统中所有可用参数",
          "hidden": false
        },
        {
          "type": "toggle",
          "param": "GsmMetered",
          "title": "启用GSM按流量计费模式",
          "desc": "切换GSM按流量计费模式",
          "hidden": false
        },
        {
          "type": "toggle",
          "param": "DisableUpdates",
          "title": "禁用更新",
          "desc": "切换禁用更新",
          "hidden": false
        },
        {
          "type": "command_button",
          "command": "echo \"Starting process...\" && for i in {1..5}; do echo \"[$(date '+%H:%M:%S')] Processing batch $i/5...\"; sleep 1; echo \"  -> Completed subtask $i\"; sleep 1; done && echo \"All tasks completed successfully!\"",
          "working_dir": "/data/openpilot",
          "title": "测试命令",
          "desc": "测试命令",
          "button_text": "测试命令",
          "confirm": true,
          "confirm_text": "您确定要运行此命令吗？",
          "confirm_button_text": "运行",
          "cancel_button_text": "取消",
          "hidden": false,
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        },
        {
          "type": "command_button",
          "command": "wget https://raw.githubusercontent.com/tonesto7/op-utilities/main/CommaUtility.sh && chmod +x /data/CommaUtility.sh",
          "working_dir": "/data",
          "title": "安装Comma工具",
          "desc": "安装Comma工具",
          "button_text": "安装",
          "confirm": false,
          "hidden": false,
          "OnlyOnCommaDevice": true,
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        },
        {
          "type": "file_viewer",
          "path": "/data/community/crashes/error.txt",
          "title": "最近崩溃",
          "desc": "查看崩溃文件",
          "button_text": "查看错误",
          "confirm": false,
          "hidden": false,
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        },
        {
          "type": "command_button",
          "command": "ifconfig",
          "working_dir": "/data/openpilot",
          "title": "获取网络信息",
          "desc": "使用ifconfig获取网络信息",
          "button_text": "获取信息",
          "confirm": false,
          "hidden": false,
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        },
        {
          "type": "command_button",
          "command": "tail -f /tmp/launch_log",
          "working_dir": "/data/openpilot",
          "title": "查看启动日志",
          "desc": "查看启动日志",
          "button_text": "查看日志",
          "confirm": false,
          "hidden": false,
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        }
      ]
    }
  ]
}
