{
  "type": "base",
  "menuName": "车辆",
  "menuIcon": "../../sunnypilot/selfdrive/assets/offroad/icon_vehicle.svg",
  "menuDescription": "车辆设置和平台选择",
  "groups": [
    {
      "groupName": "platformSelectionGroup",
      "title": "平台选择",
      "controls": [
        {
          "type": "platform_display",
          "title": "当前车辆",
          "desc": "显示活动车辆指纹，优先级：\n1. BluePilot Ford车辆选择器（如果已设置）\n2. SunnyPilot手动选择（如果已设置）\n3. 从CAN指纹自动检测\n\n🟢 = 自动指纹识别 | 🔵 = 手动选择 | 🟡 = 未识别",
          "value_param": "VehiclePlatformDisplay",
          "value_color": "#0086E9"
        },
        {
          "type": "selection",
          "param": "FordSelectedVehicleModel",
          "title": "BluePilot Ford车辆选择器",
          "desc": "强制Ford车辆的指纹以退出行车记录仪模式。此设置优先于SunnyPilot手动选择。\n\n🔵 选择您特定的Ford/Lincoln车辆型号以覆盖自动检测。",
          "requiresReboot": false,
          "options": [
            {
              "name": "自动检测",
              "value": ""
            },
            {
              "name": "Ford Bronco Sport (2021-2024)",
              "value": "FORD_BRONCO_SPORT_MK1"
            },
            {
              "name": "Ford Edge (2019-2024)",
              "value": "FORD_EDGE_MK2"
            },
            {
              "name": "Ford Escape (2020-2022)",
              "value": "FORD_ESCAPE_MK4"
            },
            {
              "name": "Ford Escape (2023-2025)",
              "value": "FORD_ESCAPE_MK4_5"
            },
            {
              "name": "Ford Expedition (2022-2024)",
              "value": "FORD_EXPEDITION_MK4"
            },
            {
              "name": "Ford Explorer (2020-2024)",
              "value": "FORD_EXPLORER_MK6"
            },
            {
              "name": "Ford F-150 (2021-2023)",
              "value": "FORD_F_150_MK14"
            },
            {
              "name": "Ford F-150 Lightning (2022-2025)",
              "value": "FORD_F_150_LIGHTNING_MK1"
            },
            {
              "name": "Ford Maverick 1st Gen",
              "value": "FORD_MAVERICK_MK1"
            },
            {
              "name": "Ford Mustang Mach-E (2021-2024)",
              "value": "FORD_MUSTANG_MACH_E_MK1"
            },
            {
              "name": "Ford Ranger (2023-2024)",
              "value": "FORD_RANGER_MK2"
            },
            {
              "name": "Lincoln Aviator (2020-2024)",
              "value": "FORD_EXPLORER_MK6"
            },
            {
              "name": "Lincoln Corsair (2020-2022)",
              "value": "FORD_ESCAPE_MK4"
            },
            {
              "name": "Lincoln Corsair (2023-2025)",
              "value": "FORD_ESCAPE_MK4_5"
            },
            {
              "name": "Lincoln Nautilus (2019-2024)",
              "value": "FORD_EDGE_MK2"
            },
            {
              "name": "Lincoln Navigator (2022-2024)",
              "value": "FORD_EXPEDITION_MK4"
            }
          ]
        },
        {
          "type": "command_button",
          "title": "手动车辆选择",
          "desc": "如果自动指纹识别失败或您想覆盖检测到的车辆，请搜索并手动选择您的车辆。",
          "button_text": "搜索",
          "action": "search_platform"
        },
        {
          "type": "command_button",
          "title": "移除手动选择",
          "desc": "移除手动选择的车辆（BluePilot或SunnyPilot）并返回自动指纹识别。",
          "button_text": "移除",
          "action": "remove_platform",
          "visibleConditions": {
            "anyConditionsTrue": [
              { "paramExists": "FordSelectedVehicleModel" },
              { "paramExists": "CarPlatformBundle" }
            ]
          }
        }
      ]
    },
    {
      "groupName": "hyundaiSettingsGroup",
      "title": "现代设置",
      "hidden": true,
      "controls": [
        {
          "type": "selection",
          "param": "HyundaiLongitudinalTuning",
          "title": "自定义纵向调谐",
          "desc": "",
          "dynamic_desc": true,
          "descriptions": {
            "off": "此功能为支持的现代/起亚/Genesis车辆提供自定义纵向控制调谐。\n\n<b>关闭：</b>使用默认纵向控制。",
            "dynamic": "此功能为支持的现代/起亚/Genesis车辆提供自定义纵向控制调谐。\n\n<b>动态：</b>平滑、动态的响应，适应驾驶条件。\n• 更适合高速公路巡航\n• 更渐进的加速/减速\n• 乘客更舒适",
            "predictive": "此功能为支持的现代/起亚/Genesis车辆提供自定义纵向控制调谐。\n\n<b>预测：</b>城市驾驶的快速、响应行为。\n• 更适合走走停停的交通\n• 对前车变化的反应更快\n• 更激进的加速/减速",
            "disabled": "启动车辆以检查兼容性。\n此功能需要openpilot纵向控制可用。"
          },
          "description_conditions": {
            "off": {
              "paramValueEquals": {
                "HyundaiLongitudinalTuning": "0"
              }
            },
            "dynamic": {
              "paramValueEquals": {
                "HyundaiLongitudinalTuning": "1"
              }
            },
            "predictive": {
              "paramValueEquals": {
                "HyundaiLongitudinalTuning": "2"
              }
            },
            "disabled": {
              "anyConditionsTrue": [
                { "isOffroad": true },
                { "hasLongitudinalControl": false }
              ]
            }
          },
          "options": [
            {
              "value": "0",
              "label": "关闭",
              "default": true
            },
            {
              "value": "1",
              "label": "动态"
            },
            {
              "value": "2",
              "label": "预测"
            }
          ],
          "enableConditions": {
            "allConditionsTrue": [
              { "isOnroad": true },
              { "hasLongitudinalControl": true }
            ]
          },
          "visibleConditions": {
            "allConditionsTrue": [{ "brandEquals": "hyundai" }]
          }
        }
      ]
    },
    {
