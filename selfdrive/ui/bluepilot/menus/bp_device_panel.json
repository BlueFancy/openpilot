{
  "_comment": "BluePilot Device Settings - Standardized UI for device controls migrated from SunnyPilot",
  "menuName": "设备",
  "menuIcon": "icon_device.png",
  "menuDescription": "设备设置",
  "persistentParams": [],
  "clearOnManagerStartParams": [],
  "clearOnOnroadTransitionParams": [],
  "clearOnOffroadTransitionParams": [],
  "groups": [
    {
      "groupName": "quickActionsGroup",
      "title": "快速操作",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "OffroadMode",
          "title": "始终离线模式",
          "desc": "防止设备进入在线状态。启用后，openpilot将不会启动。",
          "confirm": true,
          "confirm_text": "您确定要切换始终离线模式吗？",
          "confirm_yes_text": "是",
          "confirm_no_text": "否",
          "dynamic_title": true,
          "titles": {
            "enabled": "退出始终离线模式",
            "disabled": "启用始终离线模式"
          },
          "dynamic_styling": true,
          "styles": {
            "enabled": {
              "background_color": "#E22C2C"
            },
            "disabled": {
              "background_color": "#393939"
            }
          }
        },
        {
          "type": "toggle",
          "param": "QuietMode",
          "title": "静音模式",
          "desc": "静音所有通知声音。"
        },
        {
          "type": "command_button",
          "title": "驾驶员摄像头预览",
          "desc": "预览面向驾驶员的摄像头。",
          "button_text": "预览",
          "action": "show_driver_camera",
          "webSupported": false
        },
        {
          "type": "command_button",
          "title": "培训指南",
          "desc": "查看培训指南以学习如何使用openpilot。",
          "button_text": "查看",
          "action": "show_training_guide",
          "confirm": true,
          "confirm_text": "您确定要查看培训指南吗？",
          "confirm_yes_text": "查看",
          "confirm_no_text": "取消",
          "connect_signal": "reviewTrainingGuide",
          "webSupported": false
        },
        {
          "type": "command_button",
          "title": "语言",
          "desc": "更改设备语言。",
          "button_text": "更改",
          "action": "show_language_selector",
          "connect_signal": "showLanguageSelector",
          "webSupported": false
        },
        {
          "type": "command_button",
          "title": "法规信息",
          "desc": "查看法规和合规信息。",
          "button_text": "查看",
          "action": "show_regulatory",
          "connect_signal": "showRegulatory",
          "webSupported": false
        },
        {
          "type": "command_button",
          "title": "重置设置",
          "desc": "将所有设置重置为默认值。此操作无法撤销。",
          "button_text": "重置",
          "action": "reset_settings",
          "confirm": true,
          "confirm_text": "您确定要将所有sunnypilot设置重置为默认值吗？一旦重置，将无法恢复。",
          "confirm_yes_text": "重置",
          "confirm_no_text": "取消"
        },
        {
          "type": "file_viewer",
          "path": "CHANGELOGS_BP.md",
          "title": "BluePilot更新日志",
          "desc": "查看BluePilot的最新更改和更新",
          "header": "BluePilot更新日志",
          "webSupported": false,
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        },
        {
          "type": "recent_changes",
          "title": "最近更改",
          "desc": "查看当前版本的最近更改和更新",
          "conditions": {
            "git_remote": ["any"],
            "git_branch": []
          }
        }
      ]
    },
    {
      "groupName": "calibrationGroup",
      "title": "校准",
      "enableResetButton": false,
      "controls": [
        {
          "type": "command_button",
          "title": "重置校准",
          "desc": "openpilot持续进行校准，很少需要重置。如果车辆已启动，重置校准将重启openpilot。",
          "button_text": "重置",
          "action": "remove_params",
          "params": [
            "CalibrationParams",
            "LiveTorqueParameters",
            "LiveParameters"
          ],
          "confirm": true,
          "confirm_text": "您确定要重置校准吗？",
          "confirm_yes_text": "重置",
          "confirm_no_text": "取消"
        }
      ]
    },

    {
      "groupName": "deviceSettingsGroup",
      "title": "设备设置",
      "enableResetButton": false,
      "controls": [
        {
          "type": "selection",
          "param": "MaxTimeOffroad",
          "title": "最大离线时间",
          "desc": "发动机关闭后，设备将在设定时间后自动关机。（默认30小时）",
          "options": [
            { "name": "始终开启", "value": "0" },
            { "name": "5分钟", "value": "5" },
            { "name": "10分钟", "value": "10" },
            { "name": "15分钟", "value": "15" },
            { "name": "30分钟", "value": "30" },
            { "name": "1小时", "value": "60" },
            { "name": "2小时", "value": "120" },
            { "name": "3小时", "value": "180" },
            { "name": "5小时", "value": "300" },
            { "name": "10小时", "value": "600" },
            { "name": "24小时", "value": "1440" },
            { "name": "30小时（默认）", "value": "1800", "default": true }
          ]
        },
        {
          "type": "segmented_control",
          "param": "DeviceBootMode",
          "title": "唤醒行为",
          "desc": "控制设备启动/唤醒后的状态。<br><br>⁍ 默认：设备将正常启动/唤醒，并准备就绪。<br>⁍ 离线：设备启动/唤醒后将处于始终离线模式。",
          "options": [
            { "name": "默认", "value": "0", "default": true },
            { "name": "离线", "value": "1" }
          ]
        }
      ]
    },
    {
      "groupName": "deviceInfoGroup",
      "title": "设备/软件信息",
      "enableResetButton": false,
      "controls": [
        {
          "type": "static_param_display",
          "param": "DongleId",
          "title": "设备ID",
          "desc": "",
          "webSupported": false
        },
        {
          "type": "static_param_display",
          "param": "HardwareSerial",
          "title": "序列号",
          "desc": "",
          "webSupported": false
        },
        {
          "type": "file_param_display",
          "file": "../../BPVERSION",
          "title": "BluePilot版本",
          "desc": "",
          "prefix": "v",
          "webSupported": false
        },
        {
          "type": "file_param_display",
          "file": "COMMA_VERSION",
          "title": "Openpilot版本",
          "desc": "",
          "webSupported": false
        }
      ]
    },
    {
      "groupName": "powerGroup",
      "title": "电源",
      "enableResetButton": false,
      "controls": [
        {
          "type": "command_button",
          "title": "重启",
          "desc": "重启设备。",
          "button_text": "重启",
          "action": "set_param",
          "param": "DoReboot",
          "value": "1",
          "confirm": true,
          "confirm_text": "您确定要重启吗？",
          "confirm_yes_text": "重启",
          "confirm_no_text": "取消",
          "button_style": {
            "background_color": "#FF8C00",
            "background_color_pressed": "#FFA500",
            "text_color": "#FFFFFF"
          }
        },
        {
          "type": "command_button",
          "title": "关机",
          "desc": "关闭设备电源。",
          "button_text": "关机",
          "action": "set_param",
          "param": "DoShutdown",
          "value": "1",
          "confirm": true,
          "confirm_text": "您确定要关机吗？",
          "confirm_yes_text": "关机",
          "confirm_no_text": "取消",
          "button_style": {
            "background_color": "#E22C2C",
            "background_color_pressed": "#FF2424",
            "text_color": "#FFFFFF"
          }
        },
        {
          "type": "restart_ui",
          "title": "重启界面",
          "desc": "重启sunnypilot用户界面以应用更改或解决显示问题。",
          "button_text": "重启界面",
          "confirm": true,
          "confirm_text": "您确定要重启用户界面吗？<br><br>界面将在几秒钟内不可用。",
          "confirm_yes_text": "重启",
          "confirm_no_text": "取消"
        }
      ]
    }
  ]
}
