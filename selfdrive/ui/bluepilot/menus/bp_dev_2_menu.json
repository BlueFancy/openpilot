    {
      "name": "横向调校",
      "icon": "../assets/offroad/icon_steering.png",
      "groups": [
        {
          "groupName": "lateralControlsGroup",
          "title": "横向控制参数：",
          "enableResetButton": true,
          "controls": [
            {
              "type": "toggle",
              "param": "FordPrefHumanTurnDetectionEnable",
              "title": "启用“人工转向检测”",
              "desc": "你手动大幅转弯时自动重置 openpilot 的转向状态，避免和你争方向盘。调不好可能影响接管体验，不熟悉建议关闭。",
              "hidden": false,
              "conditions": {
                "git_remote": ["any"],
                "git_branch": []
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningLaneChgFactorHigh",
              "title": "变道曲率因子（高）",
              "desc": "调整变道时曲率的强度：数值越低，变道越慢/柔和；数值越高，变道更接近原规划路线。",
              "hidden": false,
              "min": 0.0,
              "max": 1.0,
              "increment": 0.05,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] }
                ]
              }
            },
            {
              "type": "toggle",
              "param": "FordLatTuningTuningCustomProfile",
              "title": "使用自定义调校配置",
              "desc": "启用后，将使用自定义的横向调校配置（仅适合熟悉调参的用户）。",
              "hidden": false,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] }
                ]
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningPCBlendRatio_low_C",
              "title": "预测曲率混合比例（直路）",
              "desc": "控制在直路上“预测曲率”的混合比例，影响乒乓和漂移的程度，仅在自定义调校启用时生效。",
              "hidden": false,
              "min": 0.0,
              "max": 1.0,
              "increment": 0.05,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningTuningCustomProfile": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningPCBlendRatio_high_C",
              "title": "预测曲率混合比例（弯道）",
              "desc": "控制在弯道中“预测曲率”的混合比例，仅在自定义调校启用时生效。",
              "hidden": false,
              "min": 0.0,
              "max": 1.0,
              "increment": 0.05,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningTuningCustomProfile": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "toggle",
              "param": "FordLatTuningEnableLanePositioning",
              "title": "启用高级车道内定位",
              "desc": "开启后，可以进行更高级的车道内定位（偏左 / 居中 / 偏右）和 Lanefull 行为，不熟悉建议先关闭。",
              "hidden": false,
              "conditions": {
                "git_remote": ["any"],
                "git_branch": []
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningCustomPathOffset",
              "title": "车道内偏移量",
              "desc": "调整车在车道内的位置：负值偏左，正值偏右（单位约为米），仅在开启高级车道内定位时生效。",
              "hidden": false,
              "min": -0.5,
              "max": 0.5,
              "increment": 0.01,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningEnableLanePositioning": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "toggle",
              "param": "FordLatTuningEnableLanefullMode",
              "title": "启用 Lane Full 模式",
              "desc": "启用类似旧版 sunnypilot 的 LaneFull 模式，更积极地使用车道线进行控制。调不好的话可能导致左右晃动。",
              "hidden": false,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningEnableLanePositioning": "1"
                    }
                  }
                ]
              }
            },
            {
              "type": "float",
              "param": "FordLatTuningLCPIDGainUI",
              "title": "低曲率 PID 增益（直路居中）",
              "desc": "调整低曲率（直路/缓弯）下 PID 居中的力度：数值越大，修正越积极，容易感觉“晃”；数值越小，修正轻微但更稳。仅在自定义调校 + 高级车道内定位开启时生效。",
              "hidden": false,
              "min": 0.0,
              "max": 10.0,
              "increment": 0.1,
              "division": 100.0,
              "conditions": {
                "allConditionsTrue": [
                  { "git_remote": ["any"] },
                  { "git_branch": [] },
                  {
                    "paramValueEquals": {
                      "FordLatTuningTuningCustomProfile": "1"
                    }
                  },
                  {
                    "paramValueEquals": {
                      "FordLatTuningEnableLanePositioning": "1"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
