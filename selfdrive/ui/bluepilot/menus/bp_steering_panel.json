{
  "type": "base",
  "menuName": "转向",
  "menuIcon": "../../sunnypilot/selfdrive/assets/offroad/icon_lateral.png",
  "menuDescription": "转向和横向控制设置",
  "groups": [
    {
      "groupName": "madsGroup",
      "title": "MADS（模块化辅助驾驶系统）",
      "controls": [
        {
          "type": "toggle",
          "param": "Mads",
          "title": "模块化辅助驾驶系统 (MADS)",
          "desc": "启用备受喜爱的MADS功能。禁用开关可恢复到原始sunnypilot接合/解除接合。",
          "icon": "../assets/offroad/icon_blank.png",
          "confirm": true,
          "dynamic_desc": true,
          "descriptions": {
            "no_car": "启动车辆以检查兼容性。\n\n启用自动车道居中（ALC）和自适应巡航控制（ACC）的独立接合。",
            "limited_compatibility": "此平台支持有限的MADS设置。\n\n启用自动车道居中（ALC）和自适应巡航控制（ACC）的独立接合。",
            "full_compatibility": "此平台支持所有MADS设置。\n\n启用自动车道居中（ALC）和自适应巡航控制（ACC）的独立接合。",
            "default": "启用自动车道居中（ALC）和自适应巡航控制（ACC）的独立接合。"
          },
          "description_conditions": {
            "no_car": {
              "hasCarParams": false
            },
            "limited_compatibility": {
              "allConditionsTrue": [
                { "hasCarParams": true },
                { "isMadsLimitedBrand": true }
              ]
            },
            "full_compatibility": {
              "allConditionsTrue": [
                { "hasCarParams": true },
                { "isMadsLimitedBrand": false }
              ]
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "Requires offroad" }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "MadsMainCruiseAllowed",
          "title": "与主巡航联动",
          "desc": "注意：对于没有LFA/LKAS按钮的车辆，禁用此选项将阻止横向控制接合。",
          "icon": "../assets/offroad/icon_blank.png",
          "dynamic_desc": true,
          "descriptions": {
            "no_car": "启动车辆以检查车辆兼容性。\n\n注意：对于没有LFA/LKAS按钮的车辆，禁用此选项将阻止横向控制接合。",
            "limited_brand": "此功能默认为关闭，由于车辆限制不允许选择。\n\n注意：对于没有LFA/LKAS按钮的车辆，禁用此选项将阻止横向控制接合。",
            "default": "注意：对于没有LFA/LKAS按钮的车辆，禁用此选项将阻止横向控制接合。"
          },
          "description_conditions": {
            "no_car": {
              "hasCarParams": false
            },
            "limited_brand": {
              "isMadsLimitedBrand": true
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "isMadsLimitedBrand": false,
                "reason": "Mads limited brand is not allowed"
              }
            ]
          },
          "visibleConditions": {
            "allConditionsTrue": [{ "paramIsTrue": "Mads" }]
          }
        },
        {
          "type": "toggle",
          "param": "MadsUnifiedEngagementMode",
          "title": "统一接合模式 (UEM)",
          "desc": "通过巡航控制接合来同时接合横向和纵向控制。\n\n注意：一旦通过UEM接合横向控制，它将保持接合状态，直到通过MADS按钮手动禁用或车辆关闭。",
          "icon": "../assets/offroad/icon_blank.png",
          "dynamic_desc": true,
          "descriptions": {
            "no_car": "启动车辆以检查车辆兼容性。\n\n通过巡航控制接合来同时接合横向和纵向控制。\n\n注意：一旦通过UEM接合横向控制，它将保持接合状态，直到通过MADS按钮手动禁用或车辆关闭。",
            "limited_brand": "此功能默认为开启，由于车辆限制不允许选择。\n\n通过巡航控制接合来同时接合横向和纵向控制。\n\n注意：一旦通过UEM接合横向控制，它将保持接合状态，直到通过MADS按钮手动禁用或车辆关闭。",
            "default": "通过巡航控制接合来同时接合横向和纵向控制。\n\n注意：一旦通过UEM接合横向控制，它将保持接合状态，直到通过MADS按钮手动禁用或车辆关闭。"
          },
          "description_conditions": {
            "no_car": {
              "hasCarParams": false
            },
            "limited_brand": {
              "isMadsLimitedBrand": true
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "isMadsLimitedBrand": false,
                "reason": "Mads limited brand is not allowed"
              }
            ]
          },
          "visibleConditions": {
            "allConditionsTrue": [{ "paramIsTrue": "Mads" }]
          }
        },
        {
          "type": "segmented_control",
          "param": "MadsSteeringMode",
          "title": "制动踏板上的转向模式",
          "desc": "选择在sunnypilot中手动按下制动踏板后自动车道居中（ALC）的行为。",
          "icon": "../assets/offroad/icon_blank.png",
          "showDescBottom": true,
          "options": [
            {
              "name": "保持激活",
              "value": "0",
              "desc": "保持激活：按下制动踏板时，ALC将保持激活状态。"
            },
            {
              "name": "暂停",
              "value": "1",
              "desc": "暂停：按下制动踏板时，ALC将暂停。"
            },
            {
              "name": "解除",
              "value": "2",
              "desc": "解除：按下制动踏板时，ALC将解除。"
            }
          ],
          "dynamic_desc": true,
          "descriptions": {
            "no_car": "启动车辆以检查车辆兼容性。\n\n选择在sunnypilot中手动按下制动踏板后自动车道居中（ALC）的行为。",
            "limited_brand": "由于车辆限制，此平台仅支持解除模式。\n\n选择在sunnypilot中手动按下制动踏板后自动车道居中（ALC）的行为。",
            "default": "选择在sunnypilot中手动按下制动踏板后自动车道居中（ALC）的行为。"
          },
          "description_conditions": {
            "no_car": {
              "hasCarParams": false
            },
            "limited_brand": {
              "isMadsLimitedBrand": true
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "paramIsTrue": "Mads",
                "reason": "需要启用MADS"
              },
              { "isOffroad": true, "reason": "需要离线状态" },
              {
                "hasCarParams": true,
                "reason": "启动车辆以启用此设置"
              },
              {
                "isMadsLimitedBrand": false,
                "reason": "不允许Mads受限品牌"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "laneChangeGroup",
      "title": "变道",
      "controls": [
        {
          "type": "selection",
          "param": "AutoLaneChangeTimer",
          "title": "通过转向灯自动变道",
          "desc": "设置一个计时器，在使用转向灯时延迟自动变道操作。如果设置了计时器，则不需要在方向盘上轻推即可自动变道。默认为轻推。\n\n使用此功能时请谨慎。仅在交通和道路条件允许时使用转向灯。",
          "icon": "../assets/offroad/icon_blank.png",
          "options": [
            { "name": "关闭", "value": "-1" },
            { "name": "轻推", "value": "0", "default": true },
            { "name": "无需轻推", "value": "1" },
            { "name": "0.5 s", "value": "2" },
            { "name": "1 s", "value": "3" },
            { "name": "2 s", "value": "4" },
            { "name": "3 s", "value": "5" }
          ]
        },
        {
          "type": "toggle",
          "param": "AutoLaneChangeBsmDelay",
          "title": "自动变道：盲点延迟",
          "desc": "切换以启用延迟计时器，当盲点监控（BSM）检测到阻碍车辆时，实现无缝变道，确保安全操作。",
          "icon": "../assets/offroad/icon_blank.png",
          "enableConditions": {
            "allConditionsTrue": [
              {
                "hasBlindSpotMonitoring": true,
                "reason": "需要盲点监控"
              },
              {
                "paramValueGreaterThan": {
                  "AutoLaneChangeTimer": 0
                },
                "reason": "自动变道计时器必须为无需轻推或大于0秒"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "blinkerPauseGroup",
      "title": "转向灯暂停横向控制",
      "controls": [
        {
          "type": "toggle",
          "param": "BlinkerPauseLateralControl",
          "title": "使用转向灯暂停横向控制",
          "desc": "在低于所选期望速度行驶时，使用转向灯暂停横向控制。",
          "icon": "../assets/offroad/icon_blank.png"
        },
        {
          "type": "selection",
          "param": "BlinkerMinLateralControlSpeed",
          "title": "转向灯暂停的最小速度",
          "desc": "当转向灯激活时，低于此速度横向控制将暂停",
          "unit": "mph",
          "unitMetric": "km/h",
          "options": [
            { "name": "0 {unit}", "value": "0" },
            { "name": "5 {unit}", "value": "5" },
            { "name": "10 {unit}", "value": "10" },
            { "name": "15 {unit}", "value": "15" },
            { "name": "20 {unit}", "value": "20" },
            { "name": "25 {unit}", "value": "25" },
            { "name": "30 {unit}", "value": "30" },
            { "name": "35 {unit}", "value": "35" },
            { "name": "40 {unit}", "value": "40", "default": true },
            { "name": "45 {unit}", "value": "45" },
            { "name": "50 {unit}", "value": "50" },
            { "name": "55 {unit}", "value": "55" },
            { "name": "60 {unit}", "value": "60" },
            { "name": "65 {unit}", "value": "65" },
            { "name": "70 {unit}", "value": "70" },
            { "name": "75 {unit}", "value": "75" },
            { "name": "80 {unit}", "value": "80" }
          ],
          "visibleConditions": {
            "allConditionsTrue": [
              { "paramIsTrue": "BlinkerPauseLateralControl" }
            ]
          }
        }
      ]
    },
    {
      "groupName": "torqueControlGroup",
      "title": "扭矩横向控制",
      "controls": [
        {
          "type": "toggle",
          "param": "EnforceTorqueControl",
          "title": "强制扭矩横向控制",
          "desc": "启用此选项以强制sunnypilot使用扭矩横向控制进行转向。",
          "icon": "../assets/offroad/icon_blank.png",
          "dynamic_desc": true,
          "descriptions": {
            "angle_steering": "此车辆使用基于角度的转向，无法使用扭矩控制。",
            "nnlc_active": "已启用神经网络横向控制。禁用NNLC以使用扭矩控制。",
            "default": "启用此选项以强制sunnypilot使用扭矩横向控制进行转向。"
          },
          "description_conditions": {
            "angle_steering": {
              "isAngleSteering": true
            },
            "nnlc_active": {
              "paramIsTrue": "NeuralNetworkLateralControl"
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "需要离线状态" },
              {
                "isAngleSteering": false,
                "reason": "需要基于角度的转向"
              },
              {
                "paramIsFalse": "NeuralNetworkLateralControl",
                "reason": "需要禁用神经网络横向控制"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "LiveTorqueParamsToggle",
          "title": "自调谐",
          "desc": "为默认不使用扭矩横向控制的平台启用扭矩横向控制的自调谐。",
          "icon": "../assets/offroad/icon_blank.png",
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "Requires offroad" }
            ]
          },
          "visibleConditions": {
            "allConditionsTrue": [{ "paramIsTrue": "EnforceTorqueControl" }]
          }
        },
        {
          "type": "toggle",
          "param": "LiveTorqueParamsRelaxedToggle",
          "title": "自调谐的宽松设置（Beta）",
          "desc": "使用自调谐时的宽松设置。这允许torqued在学习值时更加宽容。",
          "icon": "../assets/offroad/icon_blank.png",
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "Requires offroad" }
            ]
          },
          "visibleConditions": {
            "allConditionsTrue": [
              { "paramIsTrue": "EnforceTorqueControl" },
              { "paramIsTrue": "LiveTorqueParamsToggle" }
            ]
          }
        }
      ]
    },
    {
      "groupName": "nnlcGroup",
      "title": "神经网络横向控制",
      "controls": [
        {
          "type": "toggle",
          "param": "NeuralNetworkLateralControl",
          "title": "神经网络横向控制 (NNLC)",
          "desc": "以前称为\"NNFF\"，这用基于神经网络训练的控制器替换了横向\"扭矩\"控制器，该神经网络基于每辆车（实际上是每个单独的EPS固件）的驾驶数据进行训练，以提高控制精度。\n\n如果您的车辆目前不受支持，请在sunnypilot Discord服务器的以下频道联系sunnypilot团队提供反馈，或提供您车辆的日志数据：#tuning-nnlc",
          "icon": "../assets/offroad/icon_blank.png",
          "confirm": true,
          "dynamic_desc": true,
          "descriptions": {
            "check_compatibility": "启动车辆以检查车辆兼容性。\n\n以前称为\"NNFF\"，这用基于神经网络训练的控制器替换了横向\"扭矩\"控制器，该神经网络基于每辆车（实际上是每个单独的EPS固件）的驾驶数据进行训练，以提高控制精度。\n\n如果您的车辆目前不受支持，请在sunnypilot Discord服务器的以下频道联系sunnypilot团队提供反馈，或提供您车辆的日志数据：#tuning-nnlc",
            "not_available": "NNLC在此平台上当前不可用。\n\n此平台使用基于角度的转向，与NNLC不兼容。",
            "torque_enforced": "已启用强制扭矩横向控制。禁用它以使用NNLC。\n\n以前称为\"NNFF\"，这用基于神经网络训练的控制器替换了横向\"扭矩\"控制器，该神经网络基于每辆车（实际上是每个单独的EPS固件）的驾驶数据进行训练，以提高控制精度。",
            "default": "以前称为\"NNFF\"，这用基于神经网络训练的控制器替换了横向\"扭矩\"控制器，该神经网络基于每辆车（实际上是每个单独的EPS固件）的驾驶数据进行训练，以提高控制精度。\n\n如果您的车辆目前不受支持，请在sunnypilot Discord服务器的以下频道联系sunnypilot团队提供反馈，或提供您车辆的日志数据：#tuning-nnlc"
          },
          "description_conditions": {
            "check_compatibility": {
              "hasCarParams": false
            },
            "not_available": {
              "allConditionsTrue": [
                { "hasCarParams": true },
                { "isAngleSteering": true }
              ]
            },
            "torque_enforced": {
              "paramIsTrue": "EnforceTorqueControl"
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "需要离线状态" },
              {
                "isAngleSteering": false,
                "reason": "需要基于角度的转向"
              },
              {
                "paramIsFalse": "EnforceTorqueControl",
                "reason": "需要禁用强制扭矩控制"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "bluepilotLateralGroup",
      "title": "BluePilot横向控制",
      "enableResetButton": true,
      "controls": [
        {
          "type": "toggle",
          "param": "FordPrefDisableBP_lat_UI",
          "title": "禁用BluePilot横向控制",
          "desc": "[BluePilot] 使用原始openpilot横向控制",
          "hidden": false
        },
        {
          "type": "toggle",
          "param": "FordPrefHumanTurnDetectionEnable",
          "title": "启用手动转向检测",
          "desc": "[BluePilot] 重置转向，这样您在手动转向时不会与方向盘对抗。",
          "hidden": false,
          "enableConditions": {
            "allConditionsTrue": [
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI",
                "reason": "需要启用BluePilot横向控制"
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningLaneChgFactorHigh",
          "title": "变道因子高",
          "desc": "[BluePilot] 调整变道曲率激进程度（值越低 = 越慢）。",
          "hidden": false,
          "min": 0.0,
          "max": 1.0,
          "increment": 0.05,
          "division": 100.0,
          "visibleConditions": {
            "allConditionsTrue": [
              { "paramIsFalse": "FordPrefDisableBP_lat_UI" }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "FordLatTuningTuningCustomProfile",
          "title": "使用自定义调谐配置文件",
          "desc": "[BluePilot] 使用自定义调谐配置文件进行高级横向控制",
          "hidden": false,
          "visibleConditions": {
            "allConditionsTrue": [
              { "paramIsFalse": "FordPrefDisableBP_lat_UI" }
            ]
          }
        }
      ]
    },
    {
      "groupName": "curvatureBlendGroup",
      "title": "曲率混合设置",
      "enableResetButton": false,
      "controls": [
        {
          "type": "float",
          "param": "FordLatTuningPCBlendRatio_low_C",
          "title": "预测曲率混合比低",
          "desc": "[BluePilot] 调整直道上预测曲率的混合比。",
          "hidden": false,
          "min": 0.0,
          "max": 1.0,
          "increment": 0.05,
          "division": 100.0,
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI"
              },
              {
                "paramIsTrue": "FordLatTuningTuningCustomProfile"
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningPCBlendRatio_high_C",
          "title": "预测曲率混合比高",
          "desc": "[BluePilot] 调整弯道中预测曲率的混合比。",
          "hidden": false,
          "min": 0.0,
          "max": 1.0,
          "increment": 0.05,
          "division": 100.0,
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI"
              },
              {
                "paramIsTrue": "FordLatTuningTuningCustomProfile"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "lanePositioningGroup",
      "title": "车道定位",
      "enableResetButton": false,
      "controls": [
        {
          "type": "toggle",
          "param": "FordLatTuningEnableLanePositioning",
          "title": "启用高级车道定位",
          "desc": "[BluePilot] 允许自定义车道定位和lanefull。",
          "hidden": false,
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI"
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningCustomPathOffset",
          "title": "车道内偏移",
          "desc": "[BluePilot] 调整车道位置 - 左（-）/ 右（+）",
          "hidden": false,
          "min": -0.5,
          "max": 0.5,
          "increment": 0.01,
          "division": 100.0,
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsTrue": "FordLatTuningEnableLanePositioning"
              },
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "FordLatTuningEnableLanefullMode",
          "title": "启用车道全宽模式",
          "desc": "[BluePilot] 启用类似于旧版SunnyPilot的自动Lanefull模式",
          "hidden": false,
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsTrue": "FordLatTuningEnableLanePositioning"
              },
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI"
              }
            ]
          }
        },
        {
          "type": "float",
          "param": "FordLatTuningLCPIDGainUI",
          "title": "低曲率PID增益",
          "desc": "[BluePilot] 调整低曲率的PID控制器增益",
          "hidden": false,
          "min": 0.0,
          "max": 10.0,
          "increment": 0.1,
          "division": 100.0,
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsTrue": "FordLatTuningTuningCustomProfile"
              },
              {
                "paramIsTrue": "FordLatTuningEnableLanePositioning"
              },
              {
                "paramIsFalse": "FordPrefDisableBP_lat_UI"
              }
            ]
          }
        }
      ]
    }
  ]
}
