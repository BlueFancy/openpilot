{
  "menuName": "开发者",
  "menuIcon": "../assets/icons/shell.png",
  "menuDescription": "开发者设置和工具",
  "groups": [
    {
      "groupName": "coreDevGroup",
      "title": "核心开发者工具",
      "controls": [
        {
          "type": "toggle",
          "param": "AdbEnabled",
          "title": "启用ADB",
          "desc": "ADB（Android调试桥）允许通过USB或网络连接到您的设备。更多信息请参见 https://docs.comma.ai/how-to/connect-to-comma。",
          "icon": "../assets/icons/shell.png",
          "enableConditions": {
            "allConditionsTrue": [{ "isOffroad": true }]
          }
        },
        {
          "type": "toggle",
          "param": "SshEnabled",
          "title": "启用SSH",
          "desc": "启用对您设备的SSH访问",
          "icon": "../assets/icons/shell.png",
          "enableConditions": {
            "allConditionsTrue": [{ "isOffroad": true }]
          }
        },
        {
          "type": "command_button",
          "title": "SSH密钥",
          "desc": "添加您的GitHub用户名以启用SSH访问。它将从GitHub获取您的公钥。",
          "button_text": "添加",
          "action": "manage_ssh_keys",
          "icon": "../assets/icons/shell.png",
          "visibleConditions": {
            "allConditionsTrue": [
              { "paramIsTrue": "SshEnabled" },
              { "isOffroad": true }
            ]
          }
        }
      ]
    },
    {
      "groupName": "debugModesGroup",
      "title": "调试模式",
      "controls": [
        {
          "type": "toggle",
          "param": "JoystickDebugMode",
          "title": "摇杆调试模式",
          "desc": "启用摇杆调试模式以进行测试",
          "icon": "../assets/icons/shell.png",
          "visibleConditions": {
            "allConditionsTrue": [{ "isReleaseBranch": false }]
          },
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "Requires offroad" }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "LongitudinalManeuverMode",
          "title": "纵向操作模式",
          "desc": "启用纵向操作模式以进行测试",
          "icon": "../assets/icons/shell.png",
          "visibleConditions": {
            "allConditionsTrue": [{ "isReleaseBranch": false }]
          },
          "enableConditions": {
            "allConditionsTrue": [
              { "isOffroad": true, "reason": "需要离线状态" },
              {
                "hasLongitudinalControl": true,
                "reason": "需要纵向控制"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "alphaLongitudinalGroup",
      "title": "实验功能",
      "controls": [
        {
          "type": "toggle",
          "param": "AlphaLongitudinalEnabled",
          "title": "openpilot纵向控制 (Alpha)",
          "desc": "<b>警告：openpilot纵向控制对此车辆处于alpha阶段，将禁用自动紧急制动（AEB）。</b><br><br>在此车辆上，sunnypilot默认使用车辆内置的ACC而不是openpilot的纵向控制。启用此选项可切换到openpilot纵向控制。启用openpilot纵向控制alpha时，建议启用实验模式。",
          "icon": "../assets/icons/speed_limit.png",
          "confirmation": true,
          "enableConditions": {
            "allConditionsTrue": [
              {
                "isReleaseBranch": false,
                "reason": "在发布分支上不可用"
              },
              {
                "hasAlphaLongitudinalAvailable": true,
                "reason": "需要alpha纵向控制可用"
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "sunnypilotDevGroup",
      "title": "sunnypilot开发者工具",
      "controls": [
        {
          "type": "toggle",
          "param": "ShowAdvancedControls",
          "title": "显示高级控制",
          "desc": "切换高级sunnypilot控制的可见性。\n这只会切换控制的可见性；它不会切换实际控制的启用/禁用状态。",
          "icon": "../assets/icons/shell.png"
        },
        {
          "type": "toggle",
          "param": "EnableGithubRunner",
          "title": "启用GitHub运行器服务",
          "desc": "启用或禁用GitHub运行器服务。",
          "icon": "../assets/icons/shell.png",
          "visibleConditions": {
            "allConditionsTrue": [{ "isReleaseBranch": false }]
          }
        },
        {
          "type": "toggle",
          "param": "EnableCopyparty",
          "title": "启用Copyparty服务",
          "desc": "Copyparty是一个非常强大的文件服务器，您可以使用它下载您的路线、查看日志，甚至从浏览器编辑一些文件。需要通过IP地址本地连接到您的comma设备。",
          "icon": "../assets/icons/network.png"
        },
        {
          "type": "command_button",
          "title": "Copyparty密码",
          "desc": "设置密码以保护对Copyparty文件服务器的访问。留空则不使用密码保护。需要重启以应用更改。",
          "button_text": "设置",
          "action": "set_copyparty_password",
          "icon": "../assets/icons/network.png",
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramIsTrue": "EnableCopyparty"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "QuickBootToggle",
          "title": "启用快速启动模式",
          "desc": "启用时，这将创建一个预构建文件以允许加速启动时间。禁用时，它会立即删除预构建文件，以便可以编译本地编辑的cpp文件。<br><br><b>要在设备上本地编辑C++文件，您必须先关闭此开关，以便可以重新编译更改。</b>",
          "icon": "../assets/icons/shell.png",
          "dynamic_desc": true,
          "descriptions": {
            "needs_disable_updates": "快速启动模式需要禁用更新。<br>请先在软件面板中启用\"禁用更新\"。",
            "enabled": "启用时，这将创建一个预构建文件以允许加速启动时间。禁用时，它会立即删除预构建文件，以便可以编译本地编辑的cpp文件。<br><br><b>要在设备上本地编辑C++文件，您必须先关闭此开关，以便可以重新编译更改。</b>"
          },
          "description_conditions": {
            "needs_disable_updates": {
              "paramIsFalse": "DisableUpdates"
            }
          },
          "visibleConditions": {
            "allConditionsTrue": [
              { "isReleaseBranch": false },
              { "isTestedBranch": false },
              { "isDevelopmentBranch": false }
            ]
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "paramIsTrue": "DisableUpdates",
                "reason": "需要在软件面板中禁用更新"
              }
            ]
          }
        },
        {
          "type": "command_button",
          "title": "错误日志",
          "desc": "查看sunnypilot崩溃的错误日志。",
          "button_text": "查看",
          "action": "view_error_log",
          "icon": "../assets/icons/shell.png"
        }
      ]
    },
    {
      "groupName": "paramViewerGroup",
      "title": "参数和日志",
      "enableResetButton": false,
      "controls": [
        {
          "type": "param_list_viewer",
          "title": "所有参数",
          "desc": "查看系统中所有可用参数",
          "hidden": false
        },
        {
          "type": "param_viewer",
          "param": "LiveParameters",
          "title": "实时参数",
          "desc": "显示实时参数"
        },
        {
          "type": "toggle",
          "param": "FordPrefEnableDebugLogs",
          "title": "启用调试日志",
          "desc": "[BLUEPILOT] 启用此选项以收集更详细的路线日志。",
          "icon": "../assets/icons/shell.png",
          "hidden": false
        }
      ]
    },
    {
      "groupName": "utilityCommandsGroup",
      "title": "实用命令",
      "enableResetButton": false,
      "controls": [
        {
          "type": "command_button",
          "command": "echo \"Starting process...\" && for i in {1..5}; do echo \"[$(date '+%H:%M:%S')] Processing batch $i/5...\"; sleep 1; echo \"  -> Completed subtask $i\"; sleep 1; done && echo \"All tasks completed successfully!\"",
          "working_dir": "/data/openpilot",
          "title": "测试命令",
          "desc": "测试命令",
          "button_text": "测试命令",
          "confirm": true,
          "confirm_text": "您确定要运行此命令吗？",
          "confirm_button_text": "运行",
          "cancel_button_text": "取消",
          "hidden": true
        },
        {
          "type": "command_button",
          "command": "wget https://raw.githubusercontent.com/tonesto7/op-utilities/main/CommaUtility.sh && chmod +x /data/CommaUtility.sh",
          "working_dir": "/data",
          "title": "安装Comma工具",
          "desc": "安装Comma工具",
          "button_text": "安装",
          "confirm": false,
          "hidden": true,
          "OnlyOnCommaDevice": true
        },
        {
          "type": "file_viewer",
          "path": "/data/community/crashes/error.txt",
          "title": "最近崩溃",
          "desc": "查看崩溃文件",
          "button_text": "查看错误",
          "confirm": false,
          "hidden": false
        },
        {
          "type": "file_viewer",
          "path": "/data/logs/bp_logger/bluepilot.log",
          "title": "BluePilot日志",
          "desc": "查看BluePilot日志",
          "button_text": "查看日志",
          "confirm": false,
          "hidden": true
        },
        {
          "type": "command_button",
          "command": "ifconfig",
          "working_dir": "/data/openpilot",
          "title": "获取网络信息",
          "desc": "使用ifconfig获取网络信息",
          "button_text": "获取信息",
          "confirm": false,
          "hidden": false
        },
        {
          "type": "command_button",
          "command": "./scripts/fix_data_permissions.sh",
          "working_dir": "/data/openpilot",
          "title": "修复数据权限",
          "desc": "修复/data和/data/openpilot目录的所有权和权限以确保正确访问（comma:comma, 755）",
          "button_text": "修复权限",
          "confirm": true,
          "confirm_text": "这会将/data和/data/openpilot的所有权重置为comma:comma，权限重置为755。继续吗？",
          "confirm_button_text": "修复",
          "cancel_button_text": "取消",
          "hidden": false,
          "OnlyOnCommaDevice": true
        },
        {
          "type": "command_button",
          "command": "./scripts/device_health_check.sh comma@localhost",
          "working_dir": "/data/openpilot",
          "title": "设备健康检查",
          "desc": "检查设备健康状态：进程、磁盘空间、内存使用、最近崩溃和关键文件。查看综合状态报告。",
          "button_text": "运行检查",
          "confirm": false,
          "hidden": false,
          "OnlyOnCommaDevice": true
        },
        {
          "type": "command_button",
          "command": "./scripts/fix_device_issues.sh",
          "working_dir": "/data/openpilot",
          "title": "修复设备问题",
          "desc": "自动修复常见设备问题：重复的管理器进程、过期的覆盖锁定和验证关键文件。可随时安全运行 - 仅修复检测到的问题。",
          "button_text": "修复问题",
          "confirm": true,
          "confirm_text": "这将检查并修复：重复的管理器进程、过期锁定和缺失文件。继续吗？",
          "confirm_button_text": "修复",
          "cancel_button_text": "取消",
          "hidden": false,
          "OnlyOnCommaDevice": true
        },
        {
          "type": "command_button",
          "command": "/data/openpilot/scripts/force_branch_update.sh --test bp-5.0-beta",
          "working_dir": "/data/openpilot",
          "command_timeout_ms": 300000,
          "title": "测试强制更新（试运行）",
          "desc": "测试模式：模拟强制更新过程而不进行任何更改。验证互联网连接、分支可用性和所有检查。安全运行 - 不会进行任何修改。",
          "button_text": "测试更新",
          "confirm": false,
          "actionButtons": [],
          "hidden": false,
          "OnlyOnCommaDevice": true
        },
        {
          "type": "command_button",
          "command": "/data/openpilot/scripts/force_branch_update.sh bp-5.0-beta",
          "working_dir": "/data/openpilot",
          "command_timeout_ms": 900000,
          "title": "强制更新到bp-5.0-beta",
          "desc": "警告：克隆bp-5.0-beta的新副本，验证完整性，然后替换/data/openpilot。使用防弹克隆，失败时自动回滚。超时：15分钟。完成后需要重启。",
          "button_text": "强制更新",
          "confirm": true,
          "confirm_text": "这将通过以下方式强制更新到bp-5.0-beta：<br>• 将新副本克隆到临时目录<br>• 验证分支、提交哈希和关键文件<br>• 替换/data/openpilot（错误时自动回滚）<br>• 修复权限<br><br><b>AGNOS更新：</b>如果您的设备需要AGNOS更新，它将在第一次重启后自动下载并安装（可能需要5-10分钟）。<br><br><b>超时：</b>操作将在15分钟后超时。<br><br>继续吗？",
          "confirm_button_text": "是，强制更新",
          "cancel_button_text": "取消",
          "actionButtons": [
            {
              "text": "重启设备",
              "action": "reboot",
              "showWhen": "success",
              "confirm": true,
              "confirm_text": "更新完成。现在重启以应用更改吗？<br><br><b>注意：</b>如果需要AGNOS更新，设备将在重启后提示您安装（这可能需要5-10分钟）。",
              "confirm_yes_text": "立即重启",
              "confirm_no_text": "稍后"
            }
          ],
          "hidden": false,
          "OnlyOnCommaDevice": true
        }
      ]
    }
  ]
}
