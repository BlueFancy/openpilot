{
  "type": "base",
  "menuName": "巡航",
  "menuIcon": "../assets/icons/speed_limit.png",
  "menuDescription": "纵向控制和巡航设置",
  "groups": [
    {
      "groupName": "cruiseControlGroup",
      "title": "巡航控制",
      "controls": [
        {
          "type": "toggle",
          "param": "IntelligentCruiseButtonManagement",
          "title": "智能巡航按钮管理 (ICBM) (Alpha)",
          "desc": "启用后，sunnypilot将尝试通过模拟按钮按压来管理内置巡航控制按钮，以实现有限的纵向控制。",
          "icon": "",
          "confirmation": true,
          "dynamic_desc": true,
          "descriptions": {
            "default": "启用后，sunnypilot将尝试通过模拟按钮按压来管理内置巡航控制按钮，以实现有限的纵向控制。",
            "unavailable_has_long": "智能巡航按钮管理在此平台上当前不可用。请禁用openpilot纵向控制（alpha）开关以允许智能巡航按钮管理。",
            "unavailable_default_long": "智能巡航按钮管理在此平台上当前不可用。openpilot纵向控制是此平台的默认纵向控制。",
            "unavailable_generic": "智能巡航按钮管理在此平台上当前不可用。",
            "offroad": "启动车辆以检查车辆兼容性。"
          },
          "description_conditions": {
            "offroad": {
              "isOffroad": true
            },
            "unavailable_has_long": {
              "allConditionsTrue": [
                {
                  "isOnroad": true
                },
                {
                  "hasIntelligentCruiseButtonManagement": false
                },
                {
                  "hasLongitudinalControl": true
                },
                {
                  "hasAlphaLongitudinalAvailable": true
                }
              ]
            },
            "unavailable_default_long": {
              "allConditionsTrue": [
                {
                  "isOnroad": true
                },
                {
                  "hasIntelligentCruiseButtonManagement": false
                },
                {
                  "hasLongitudinalControl": true
                },
                {
                  "hasAlphaLongitudinalAvailable": false
                }
              ]
            },
            "unavailable_generic": {
              "allConditionsTrue": [
                {
                  "isOnroad": true
                },
                {
                  "hasIntelligentCruiseButtonManagement": false
                }
              ]
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "isOffroad": true,
                "reason": "需要离线状态"
              },
              {
                "hasIntelligentCruiseButtonManagement": true,
                "reason": "需要ICBM"
              },
              {
                "hasLongitudinalControl": false,
                "reason": "需要禁用openpilot纵向控制"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "DynamicExperimentalControl",
          "title": "动态实验控制 (DEC)",
          "desc": "启用此开关以允许模型决定何时使用sunnypilot ACC或sunnypilot端到端纵向控制。",
          "icon": "",
          "enableConditions": {
            "allConditionsTrue": [
              {
                "hasLongitudinalControl": true,
                "reason": "需要openpilot纵向控制"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "SmartCruiseControlVision",
          "title": "智能巡航控制 - 视觉",
          "desc": "使用视觉路径预测来估算通过前方弯道的适当速度。",
          "icon": "",
          "dynamic_desc": false,
          "enableConditions": {
            "anyConditionsTrue": [
              {
                "hasLongitudinalControl": true,
                "reason": "需要openpilot纵向控制"
              },
              {
                "hasIntelligentCruiseButtonManagement": true,
                "reason": "需要ICBM"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "SmartCruiseControlMap",
          "title": "智能巡航控制 - 地图",
          "desc": "使用地图数据来估算通过前方弯道的适当速度。",
          "icon": "",
          "dynamic_desc": false,
          "enableConditions": {
            "anyConditionsTrue": [
              {
                "hasLongitudinalControl": true,
                "reason": "Requires openpilot longitudinal control"
              },
              {
                "hasIntelligentCruiseButtonManagement": true,
                "reason": "Requires ICBM"
              }
            ]
          }
        },
        {
          "type": "toggle",
          "param": "CustomAccIncrementsEnabled",
          "title": "自定义ACC速度增量",
          "desc": "启用自定义短按和长按增量以增加/减少巡航速度。",
          "icon": "",
          "dynamic_desc": true,
          "descriptions": {
            "offroad": "启动车辆以检查车辆兼容性。",
            "no_longitudinal": "此功能只能在启用openpilot纵向控制时使用。",
            "pcm_cruise_disabled": "由于车辆限制，此功能在此平台上不受支持。",
            "default": "启用自定义短按和长按增量以增加/减少巡航速度。"
          },
          "description_conditions": {
            "offroad": {
              "isOffroad": true
            },
            "no_longitudinal": {
              "allConditionsTrue": [
                {
                  "isOnroad": true
                },
                {
                  "hasLongitudinalControl": false
                },
                {
                  "isICBMAvailable": false
                }
              ]
            },
            "pcm_cruise_disabled": {
              "allConditionsTrue": [
                {
                  "isOnroad": true
                },
                {
                  "anyConditionsTrue": [
                    {
                      "hasLongitudinalControl": true
                    },
                    {
                      "hasIntelligentCruiseButtonManagement": true
                    }
                  ]
                },
                {
                  "isPcmCruise": true
                }
              ]
            }
          },
          "enableConditions": {
            "allConditionsTrue": [
              {
                "isOnroad": true,
                "reason": "需要行驶中"
              },
              {
                "anyConditionsTrue": [
                  {
                    "allConditionsTrue": [
                      {
                        "hasLongitudinalControl": true,
                        "reason": "需要openpilot纵向控制"
                      },
                      {
                        "isPcmCruise": false,
                        "reason": "需要禁用PCM巡航"
                      }
                    ]
                  },
                  {
                    "hasIntelligentCruiseButtonManagement": true,
                    "reason": "需要ICBM"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "groupName": "speedLimitGroup",
      "title": "速度限制",
      "controls": [
        {
          "type": "segmented_control",
          "param": "SpeedLimitMode",
          "title": "速度限制",
          "desc": "",
          "icon": "",
          "showDescBottom": true,
          "options": [
            {
              "name": "关闭",
              "value": "0",
              "desc": "禁用速度限制功能。",
              "default": true
            },
            {
              "name": "信息",
              "value": "1",
              "desc": "显示当前道路的速度限制。"
            },
            {
              "name": "警告",
              "value": "2",
              "desc": "当超过当前道路速度限制时提供警告。"
            },
            {
              "name": "辅助",
              "value": "3",
              "desc": "操作+/-按钮时，根据当前道路速度限制调整车辆的巡航速度。",
              "enableConditions": {
                "anyConditionsTrue": [
                  {
                    "hasLongitudinalControl": true,
                    "reason": "需要openpilot纵向控制"
                  },
                  {
                    "hasIntelligentCruiseButtonManagement": true,
                    "reason": "需要ICBM"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "segmented_control",
          "param": "SpeedLimitPolicy",
          "title": "速度限制来源",
          "desc": "",
          "icon": "",
          "showDescBottom": true,
          "options": [
            {
              "name": "仅车辆",
              "value": "0",
              "desc": "仅使用车辆内置的速度限制数据。"
            },
            {
              "name": "仅地图",
              "value": "1",
              "desc": "仅使用地图数据获取速度限制信息。",
              "default": true
            },
            {
              "name": "车辆优先",
              "value": "2",
              "desc": "优先使用车辆数据，如果不可用则回退到地图。"
            },
            {
              "name": "地图优先",
              "value": "3",
              "desc": "优先使用地图数据，如果不可用则回退到车辆。"
            },
            {
              "name": "组合数据",
              "value": "4",
              "desc": "同时使用车辆和地图数据。"
            }
          ]
        },
        {
          "type": "segmented_control",
          "param": "SpeedLimitOffsetType",
          "title": "速度限制偏移",
          "desc": "",
          "icon": "",
          "showDescBottom": true,
          "options": [
            {
              "name": "无",
              "value": "0",
              "desc": "无偏移",
              "default": true
            },
            {
              "name": "固定",
              "value": "1",
              "desc": "添加固定偏移 [速度限制 + 偏移]"
            },
            {
              "name": "百分比",
              "value": "2",
              "desc": "添加百分比偏移 [速度限制 + (偏移 % 速度限制)]"
            }
          ]
        },
        {
          "type": "integer",
          "param": "SpeedLimitValueOffset",
          "title": "固定偏移值",
          "desc": "固定速度偏移值（单位：mph/km/h）",
          "min": -30,
          "max": 30,
          "increment": 1,
          "unit": "mph",
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramValueEquals": {
                  "SpeedLimitOffsetType": "1"
                }
              }
            ]
          }
        },
        {
          "type": "integer",
          "param": "SpeedLimitValueOffset",
          "title": "百分比偏移值",
          "desc": "百分比偏移值（例如：10 = +10%）",
          "min": -50,
          "max": 50,
          "increment": 5,
          "unit": "%",
          "visibleConditions": {
            "allConditionsTrue": [
              {
                "paramValueEquals": {
                  "SpeedLimitOffsetType": "2"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
